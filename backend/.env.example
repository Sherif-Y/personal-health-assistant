# Epic on FHIR — sandbox values shown as defaults; swap for production values in Phase 7
EPIC_CLIENT_ID=your-non-production-client-id
EPIC_CLIENT_SECRET=your-client-secret
EPIC_AUTHORIZE_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_REDIRECT_URI=http://localhost:8000/auth/callback
# Resource-level access (Patient/Observation/DiagnosticReport/DocumentReference) is granted by
# the app's registered "Incoming APIs" on fhir.epic.com, not by naming each resource scope here.
# This minimal scope set is the one confirmed working against the sandbox during manual testing.
EPIC_SCOPES=openid fhirUser launch/patient offline_access

# Anthropic Claude API — used for lab/report summaries and the chat feature
ANTHROPIC_API_KEY=your-anthropic-api-key

# Local app
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/health.db
